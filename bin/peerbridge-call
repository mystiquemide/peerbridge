#!/usr/bin/env python3
"""Run one request against Dev A's backend on loopback, and only on an allowed route.

backend-agent uses this for every HTTP call. It reads a request as JSON
(method, path, optional headers and body), refuses anything outside the route
allowlist, sends it to 127.0.0.1:$PEERBRIDGE_BACKEND_PORT, and prints a reply
ready to post in the room: status, body (truncated to 2 KB) and the matching
access-log line.

Exit codes: 0 request sent (any HTTP status), 2 refused, 3 backend unreachable.
"""

import argparse
import hashlib
import http.client
import json
import os
import sys
import time
from pathlib import Path
from urllib.parse import urlsplit

HOST = "127.0.0.1"
REPO = Path(__file__).resolve().parent.parent
BODY_LIMIT = 2048
DROPPED_HEADERS = {"authorization", "cookie", "host", "proxy-authorization"}
ALLOWED_METHODS = {"GET", "POST", "PUT", "PATCH", "DELETE"}


class Refused(Exception):
    pass


def load_config(path: Path) -> dict:
    """KEY=VALUE lines from peerbridge.env next to the wrapper. They override the
    environment, so a root-owned install can't be redirected by its caller."""
    config = {}
    if path.exists():
        for raw in path.read_text(encoding="utf-8").splitlines():
            line = raw.strip()
            if line and not line.startswith("#") and "=" in line:
                key, _, value = line.partition("=")
                config[key.strip()] = value.strip()
    return config


def load_routes(path: Path) -> set[tuple[str, str]]:
    routes = set()
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        method, _, route = line.partition(" ")
        routes.add((method.upper(), route.strip()))
    return routes


def validate(request: dict, routes: set[tuple[str, str]]) -> tuple[str, str]:
    if not isinstance(request, dict):
        raise Refused("request must be a JSON object")
    for key in ("host", "url", "port"):
        if key in request:
            raise Refused(f"'{key}' isn't accepted. Requests only go to {HOST}")
    method = str(request.get("method", "")).upper()
    path = request.get("path")
    if method not in ALLOWED_METHODS:
        raise Refused(f"method '{method or '?'}' isn't supported")
    if not isinstance(path, str) or not path.startswith("/") or path.startswith("//"):
        raise Refused("path must be a plain path starting with '/'")
    parts = urlsplit(path)
    if parts.scheme or parts.netloc:
        raise Refused(f"path can't name a host. Requests only go to {HOST}")
    if ".." in parts.path.split("/") or "\\" in path or "%" in parts.path:
        raise Refused("path can't contain '..', '\\' or encoded characters")
    if (method, parts.path) not in routes:
        raise Refused(f"{method} {parts.path} isn't in the route allowlist")
    return method, path


def clean_headers(headers) -> tuple[dict, list[str]]:
    if headers is None:
        return {}, []
    if not isinstance(headers, dict):
        raise Refused("headers must be a JSON object")
    kept, dropped = {}, []
    for name, value in headers.items():
        if name.lower() in DROPPED_HEADERS:
            dropped.append(name)
        else:
            kept[str(name)] = str(value)
    return kept, dropped


def log_offset(log: Path) -> int:
    return log.stat().st_size if log.exists() else 0


def find_log_line(log: Path, offset: int, method: str, path: str) -> str | None:
    route = urlsplit(path).path
    deadline = time.monotonic() + 1.0
    while time.monotonic() < deadline:
        if log.exists():
            with log.open("r", encoding="utf-8") as fh:
                fh.seek(offset)
                for line in fh.read().splitlines():
                    if f" {method} {route} -> " in line:
                        return line
        time.sleep(0.05)
    return None


def send(method: str, path: str, headers: dict, body, port: int, timeout: float):
    payload = None
    if body is not None:
        payload = body.encode() if isinstance(body, str) else json.dumps(body).encode()
        headers.setdefault("Content-Type", "application/json")
    conn = http.client.HTTPConnection(HOST, port, timeout=timeout)
    try:
        started = time.monotonic()
        conn.request(method, path, body=payload, headers=headers)
        resp = conn.getresponse()
        data = resp.read()
        return resp.status, resp.reason, data, (time.monotonic() - started) * 1000
    finally:
        conn.close()


def format_body(data: bytes) -> str:
    text = data.decode("utf-8", errors="replace")
    try:
        text = json.dumps(json.loads(text), indent=2)
    except ValueError:
        pass
    if len(text.encode()) > BODY_LIMIT:
        text = text.encode()[:BODY_LIMIT].decode("utf-8", errors="ignore") + "\n... (truncated to 2 KB)"
    return text


def run(argv: list[str], stdin) -> tuple[int, str]:
    parser = argparse.ArgumentParser(prog="peerbridge-call", description=__doc__.splitlines()[0])
    parser.add_argument("--request-file", help="JSON request file. Reads stdin when omitted.")
    parser.add_argument("--message-id", help="Room message id. A repeat id returns the first result without re-sending.")
    parser.add_argument("--timeout", type=float, default=10.0)
    args = parser.parse_args(argv)

    settings = {**os.environ, **load_config(REPO / "peerbridge.env")}
    port = int(settings.get("PEERBRIDGE_BACKEND_PORT", "8001"))
    routes = load_routes(Path(settings.get("PEERBRIDGE_ROUTES", REPO / "peerbridge.routes")))
    log = Path(settings.get("PEERBRIDGE_ACCESS_LOG", REPO / "sample" / "backend" / "access.log"))
    state = Path(settings.get("PEERBRIDGE_STATE_DIR", REPO / ".peerbridge")) / "results"
    tag = f" [re: {args.message_id}]" if args.message_id else ""

    cached = None
    if args.message_id:
        cached = state / (hashlib.sha256(args.message_id.encode()).hexdigest()[:32] + ".txt")
        if cached.exists():
            return 0, cached.read_text(encoding="utf-8") + "\n(already ran for this message, not sent again)"

    try:
        raw = Path(args.request_file).read_text(encoding="utf-8") if args.request_file else stdin.read()
        try:
            request = json.loads(raw)
        except ValueError as exc:
            raise Refused(f"request isn't valid JSON ({exc.msg})") from None
        method, path = validate(request, routes)
        headers, dropped = clean_headers(request.get("headers"))
    except Refused as exc:
        return 2, f"REFUSED by peerbridge-call{tag}: {exc}. No request was sent."

    offset = log_offset(log)
    try:
        status, reason, data, ms = send(method, path, headers, request.get("body"), port, args.timeout)
    except OSError as exc:
        return 3, f"Backend unreachable{tag} on {HOST}:{port} ({exc.__class__.__name__}). No response."

    line = find_log_line(log, offset, method, path)
    out = [
        f"{method} {path} -> {status} {reason} ({ms:.0f} ms, {HOST}:{port}){tag}",
        "```json",
        format_body(data),
        "```",
        f"access log: {line}" if line else "access log: no matching line found",
    ]
    if dropped:
        out.append(f"dropped headers: {', '.join(dropped)}")
    result = "\n".join(out)
    if cached:
        cached.parent.mkdir(parents=True, exist_ok=True)
        cached.write_text(result, encoding="utf-8")
    return 0, result


def main() -> int:
    code, text = run(sys.argv[1:], sys.stdin)
    print(text)
    return code


if __name__ == "__main__":
    sys.exit(main())
